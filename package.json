{
  "name": "dsh-task-queue",
  "version": "0.1.0",
  "description": "Task queue view for DeepSeek Harness: record items per project, set priorities, send them to the conversation with one click or automatically by priority, and watch each item's progress.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "tasks",
    "todo",
    "queue",
    "priority",
    "conversation-view"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets/*.png"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuexue61/dsh-task-queue.git"
  },
  "homepage": "https://github.com/xuexue61/dsh-task-queue#readme",
  "bugs": {
    "url": "https://github.com/xuexue61/dsh-task-queue/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}